# Copy to .env and fill in. .env is gitignored - never commit real keys.

# --- Coaching layer (optional) ---
# The app works fully offline without a key: it falls back to a built-in
# heuristic coach. Add a key to get natural-language, level-adaptive coaching.

# Anthropic (preferred if both are set)
ANTHROPIC_API_KEY=
COACH_MODEL=claude-sonnet-4-5

# OpenAI-compatible fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Server ---
PORT=5173
HOST=127.0.0.1

# --- Engine ---
# lite-single (7MB, no COOP/COEP headers needed) is the recommended default.
# Options: stockfish-18-lite-single | stockfish-18-single | stockfish-18-lite | stockfish-18
ENGINE_BUILD=stockfish-18-lite-single
