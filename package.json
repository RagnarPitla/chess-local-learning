{
  "name": "chess-local-learning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adaptive chess trainer: Stockfish WASM analysis + principle-based coaching that learns your personal weakness patterns",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"scripts/*.test.js\"",
    "test:e2e": "node scripts/smoke.mjs",
    "test:all": "npm test && npm run test:e2e",
    "build": "node scripts/build-static.mjs",
    "build:check": "node scripts/build-static.mjs --check",
    "build:pages": "node scripts/build-static.mjs --base=/chess-local-learning/",
    "build:eco": "node scripts/build-eco.mjs",
    "ci:local": "bash scripts/local-ci.sh",
    "ci:local:quick": "bash scripts/local-ci.sh --quick",
    "ci:cron:install": "bash scripts/local-ci-cron.sh install",
    "ci:cron:remove": "bash scripts/local-ci-cron.sh remove",
    "ci:cron:status": "bash scripts/local-ci-cron.sh status"
  },
  "keywords": [
    "chess",
    "stockfish",
    "adaptive-learning",
    "spaced-repetition"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "cm-chessboard": "^8.12.19",
    "stockfish": "^18.0.8"
  }
}
